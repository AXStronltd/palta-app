{
  "expo": {
    "name": "Palta",
    "slug": "palta",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "scheme": "palta",
    "splash": {
      "backgroundColor": "#08131F",
      "resizeMode": "contain",
      "image": "./assets/icon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.palta.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Palta uses your location to show nearby restaurants and shops and to track your delivery.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Palta uses your location to track deliveries in real time.",
        "NSCameraUsageDescription": "Palta uses the camera for order and delivery photos."
      }
    },
    "android": {
      "package": "io.palta.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08131F"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "INTERNET"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      },
      "apiUrl": "https://palta-app.onrender.com"
    }
  }
}